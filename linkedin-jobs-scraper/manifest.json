{
  "manifest_version": 3,
  "name": "LinkedIn Jobs Scraper",
  "version": "1.3.0",
  "description": "Collect LinkedIn job postings by role, experience and posting time, plus hiring posts from your feed. Export to CSV or JSON.",
  "permissions": ["storage", "unlimitedStorage", "scripting", "notifications"],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://boards-api.greenhouse.io/*",
    "https://api.lever.co/*",
    "https://api.ashbyhq.com/*"
  ],
  "action": { "default_title": "Open LinkedIn Jobs Scraper" },
  "background": { "service_worker": "background.js" }
}
